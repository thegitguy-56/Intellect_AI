# Neon Postgres — use the POOLED connection string (has "-pooler" in the host)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=patent-node-studio
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Groq (LLM for chat, summarization, gap analysis, risk scoring)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings (HashingVectorizer, not a trained model — lightweight by design)
EMBEDDING_DIM=384

# spaCy NER model
SPACY_MODEL_NAME=en_core_web_sm

# Shared secret: Next.js sends this header so only our own frontend can call
# internal FastAPI endpoints (e.g. /analyze) directly.
INTERNAL_API_KEY=change-me-to-a-random-string

# Comma-separated list is not supported by pydantic-settings list parsing from
# env directly — override via a JSON array string if you need more than one origin,
# e.g. CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]
