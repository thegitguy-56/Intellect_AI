{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/d", "/c", "cd /d frontend && npm run dev"],
      "port": 3000
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/d", "/c", "cd /d backend && venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000"],
      "port": 8000
    }
  ]
}
